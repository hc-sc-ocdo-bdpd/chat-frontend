# Shared Azure connection
# The base URL must end with /openai/v1/
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=

# Azure deployment names, shown in this numeric order.
# At least one deployment is required. Add _2, _3, and so on for more models.
AZURE_OPENAI_DEPLOYMENT_1=

# Optional friendly label. Without it, the deployment name is shown.
# AZURE_OPENAI_LABEL_1=

# Example additional model:
# AZURE_OPENAI_DEPLOYMENT_2=
# AZURE_OPENAI_LABEL_2=

# Optional per-model overrides:
# AZURE_OPENAI_REASONING_EFFORTS_2=auto,low,medium,high
# AZURE_OPENAI_DEFAULT_REASONING_EFFORT_2=medium
# AZURE_OPENAI_VERBOSITY_OPTIONS_2=low,medium,high
# AZURE_OPENAI_DEFAULT_VERBOSITY_2=medium
# AZURE_OPENAI_CODE_INTERPRETER_2=true
# AZURE_OPENAI_WEB_SEARCH_2=true
# AZURE_OPENAI_MAX_OUTPUT_TOKENS_2=16384
