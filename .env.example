# Shared Azure connection
# The base URL must end with /openai/v1/
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=

# Azure deployment names, shown in this numeric order.
# At least one deployment is required. Add _2, _3, and so on for more models.
AZURE_OPENAI_DEPLOYMENT_1=

# Optional friendly label. Without it, the deployment name is shown.
# AZURE_OPENAI_LABEL_1=

# Example additional model:
# AZURE_OPENAI_DEPLOYMENT_2=
# AZURE_OPENAI_LABEL_2=

# Optional per-model overrides:
# AZURE_OPENAI_REASONING_EFFORTS_2=auto,low,medium,high
# AZURE_OPENAI_DEFAULT_REASONING_EFFORT_2=medium
# AZURE_OPENAI_VERBOSITY_OPTIONS_2=low,medium,high
# AZURE_OPENAI_DEFAULT_VERBOSITY_2=medium
# AZURE_OPENAI_CODE_INTERPRETER_2=true
# AZURE_OPENAI_WEB_SEARCH_2=true
# AZURE_OPENAI_MAX_OUTPUT_TOKENS_2=16384

# Stream recovery uses GET against the same saved Azure response.
# APP_STREAM_RESUME_ATTEMPTS=8
# Extra paid generation on token exhaustion is OFF unless explicitly enabled.
# APP_MAX_AUTO_CONTINUATIONS=0

# Long-running requests avoid the unrecoverable pre-response-ID streaming window
# by creating a durable background response first and polling its saved ID.
# auto = use this for reasoning=max or max_output_tokens >= threshold.
# always = use durable polling for every background response.
# never = always use the original streaming start.
# APP_DURABLE_START_MODE=auto
# APP_DURABLE_START_MAX_OUTPUT_TOKENS=65536

# Large Code-Interpreter-only files are split into small transport ZIP shards.
# Every shard uses the normal Azure Files API and is reconstructed in Code Interpreter.
# APP_LARGE_FILE_SHARD_THRESHOLD_MB=32
# APP_LARGE_FILE_SHARD_MB=16
